{
  "expo": {
    "name": "Turno",
    "slug": "turno",
    "owner": "abelfelizo",
    "version": "1.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/267b66a1-2afe-4194-adb1-45855f0dd9e4",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "turno",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turno.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.turno.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E1251B"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Turno usa tus fotos para tu foto de perfil y el logo del local."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "267b66a1-2afe-4194-adb1-45855f0dd9e4"
      }
    },
    "icon": "./assets/icon.png"
  }
}
